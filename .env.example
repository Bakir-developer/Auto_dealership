DATABASE_URL=sqlite:///./auto_salon.db
SECRET_KEY=<сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))">
ALGORITHM=HS256
ACCESS_EXPIRE_TOKEN=15
REFRESH_EXPIRE_TOKEN=7

# Первый администратор (python -m mysite.seed)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PHONE=+996XXXXXXXXX
# ADMIN_PASSWORD — не короче 8 символов, обязательно задайте свой
ADMIN_PASSWORD=

# Каталог загруженных файлов (в docker переопределяется в docker-compose.yml)
MEDIA_DIR=media

# Фоновая отмена просроченной брони: интервал проверки (сек) и включение задачи
RESERVATION_CHECK_SECONDS=60
RESERVATION_SCHEDULER_ENABLED=true
