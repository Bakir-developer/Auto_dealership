{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(black:*)",
      "Bash(python -m black:*)",
      "Bash(.venv/Scripts/python.exe -m black:*)",
      "Bash(isort:*)",
      "Bash(python -m isort:*)",
      "Bash(.venv/Scripts/python.exe -m isort:*)",
      "Bash(flake8:*)",
      "Bash(python -m flake8:*)",
      "Bash(.venv/Scripts/python.exe -m flake8:*)",
      "Bash(alembic:*)",
      "Bash(python -m alembic:*)",
      "Bash(.venv/Scripts/python.exe -m alembic:*)",
      "Bash(.venv/Scripts/alembic.exe:*)"
    ],
    "ask": [
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(.venv/Scripts/python.exe -m pip install:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git stash:*)",
      "Bash(gh:*)",
      "Bash(rm *.db)",
      "Bash(rm *.sqlite3)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Write(./.env)",
      "Write(./**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_dangerous_commands.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests_on_stop.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
